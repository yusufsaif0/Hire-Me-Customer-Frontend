{
  "name": "trusted-customer-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --port 8081",
    "web": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc --ignoreConfig src/lib/contracts.ts src/auth/client.ts --rootDir src --outDir .test-build --module Node16 --moduleResolution Node16 --target ES2022 --esModuleInterop --skipLibCheck && node --test test/*.test.cjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:ui": "node scripts/ui-check.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "expo": "57.0.27",
    "expo-secure-store": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.57.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
